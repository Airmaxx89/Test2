static func get_quest(id: String) -> Dictionary:
	return QUESTS.get(id, {})

static func get_starting_quests() -> Array:
	var out := []
	for id in QUESTS.keys():
		if QUESTS[id]["requires"] == "":
			out.append(id)
	return out
