; Engine configuration file.
; Godot 4.3+  —  Offline Singleplayer Fantasy Action-RPG (Android / Mobile)
;
; Diese Datei ist im Godot-Text-Format. Beim ersten Oeffnen im Editor
; werden fehlende Import-Dateien (.import) automatisch generiert.

config_version=5

[application]

config/name="Aetheria - Mobile Fantasy RPG"
config/description="Offline Singleplayer WoW-aehnliches Action-RPG, optimiert fuer Android."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)
boot_splash/show_image=true

[autoload]

; Reihenfolge ist WICHTIG (Abhaengigkeiten in _ready):
;  Events  -> muss zuerst da sein (viele verbinden sich in _ready darauf)
;  Database-> statische Spieldaten, keine Abhaengigkeiten
;  danach die restlichen Systeme, die Events/Database nutzen.
Events="*res://scripts/autoload/events.gd"
Database="*res://scripts/autoload/database.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
QuestTracker="*res://scripts/autoload/quest_tracker.gd"
PoolManager="*res://scripts/autoload/pool_manager.gd"

[debug]

settings/stdout/verbose_stdout=false

[display]

; Mobile: Portrait oder Landscape? Fuer Action-RPG -> Landscape (sensor_landscape)
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Verhindert versehentliches Multi-Touch-Chaos nicht — wir brauchen Multitouch:
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

; 60 FPS Ziel: Physics-Tick auf 60 fuer gleichmaessiges Movement.
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
2d/run_on_separate_thread=false
3d/run_on_separate_thread=false
; Standard-Gravitation
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
environment/glow/upscale_mode=0
environment/defaults/default_environment="res://scenes/world/default_env.tres"
occlusion_culling/use_occlusion_culling=true
limits/spatial_indexer/threaded_cull_minimum_instances=500

[rendering.frame_pacing]

; Godot 4 respektiert Engine.max_fps zur Laufzeit (siehe GameManager)

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="player_hitbox"
3d_physics/layer_5="enemy_hitbox"
3d_physics/layer_6="interactable"
3d_physics/layer_7="projectile"
3d_physics/layer_8="loot"
