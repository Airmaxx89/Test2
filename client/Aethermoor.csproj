<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <!-- Muss zur installierten Godot-Editor-Version passen (aktuell 4.7.x, .NET SDK 10). -->
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- Verbindliche Codequalität (siehe docs/CODING_STANDARDS.md) -->
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RootNamespace>Aethermoor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nakama-.NET-SDK — nur im Networking/Nakama-Adapter verwendet (ADR-0002). -->
    <PackageReference Include="NakamaClient" Version="3.12.0" />
  </ItemGroup>
</Project>
