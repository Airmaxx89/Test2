<Project Sdk="Godot.NET.Sdk/4.4.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- net7.0 wenn ältere Godot-4-Version; net8.0 ist Ziel dieses Projekts. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- Verbindliche Codequalität (siehe docs/CODING_STANDARDS.md) -->
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RootNamespace>Aethermoor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nakama-.NET-SDK — nur im Networking/Nakama-Adapter verwendet (ADR-0002). -->
    <PackageReference Include="NakamaClient" Version="3.12.0" />
  </ItemGroup>
</Project>
